DATABASE_URL=postgresql+psycopg://skilltrack_user:YOUR_PASSWORD@localhost:5432/skilltrack
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480

FRONTEND_URL=http://localhost:5173
# Public URL embedded in QR codes on certificates; usually the same as FRONTEND_URL
# On Render/Railway set to your public domain, e.g. https://skilltrack.onrender.com
PUBLIC_BASE_URL=http://localhost:5173


# For Question Generation
LLM_PROVIDER = gemini

OLLAMA_MODEL = qwen2.5:7b
OLLAMA_BASE_URL = http://localhost:11434

GEMINI_MODEL = gemini-3.5-flash-lite
GEMINI_API_KEY = YOUR_GEMINI_API_KEY

MAX_REGENERATION_ROUNDS = 3
DUPLICATE_SIMILARITY_THRESHOLD = 0.85  
MOCK_LLM = false
# Neon connection string (Neon console > Connect). Required: the API will not start without it.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Required, at least 32 random characters (the API refuses to start otherwise):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
# Longest a sign-in lasts; the refresh token is rotated on every use and kept in an httpOnly cookie
REFRESH_TOKEN_MINUTES=1440
# Optional: end sessions unused for this many minutes (0 = off: a sign-in lasts its full day, across browser restarts)
SESSION_IDLE_MINUTES=0
# true: a student signing in again ends their other sessions (stops sharing a sign-in)
ONE_SESSION_PER_STUDENT=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy or rate-limited
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash

FRONTEND_URL=http://localhost:5173
# Public URL embedded in QR codes on certificates; usually the same as FRONTEND_URL
# On Render/Railway set to your public domain, e.g. https://skilltrack.onrender.com
PUBLIC_BASE_URL=http://localhost:5173

# CORS origins (comma-separated for production, local regex handles dev)
# Example for production: CORS_ORIGINS=https://skilltrack-web.onrender.com,https://www.skilltrack.com
CORS_ORIGINS=

# Neon connection string (Neon console > Connect). Required: the API will not start without it.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_MINUTES=1440

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

FRONTEND_URL=http://localhost:5173
# Public URL embedded in QR codes on certificates; usually the same as FRONTEND_URL
# On Render/Railway set to your public domain, e.g. https://skilltrack.onrender.com
PUBLIC_BASE_URL=http://localhost:5173
